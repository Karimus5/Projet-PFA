# Modèle de configuration locale : copier ce fichier en .env (jamais versionné) et adapter.
# Ce fichier est lu par Docker Compose ET par les services Spring (import de ../.env).
# Format KEY=valeur, sans guillemets ni espaces autour du "=" ; éviter le caractère "\".

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=reclamations
POSTGRES_PASSWORD=change-me
# Base par défaut de l'image ; les bases des services sont créées par docker/postgres/init/.
POSTGRES_DB=postgres
# Changer le port si un PostgreSQL est déjà installé sur la machine (ex. 5433).
POSTGRES_PORT=5432

# --- JWT (auth-service, puis api-gateway) ---
# Secret HS256 partagé, AU MOINS 32 caractères. Aucune valeur par défaut : le service refuse de
# démarrer sans. Générer une valeur aléatoire dans PowerShell :
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
# Durée de validité des jetons (ex. 30m, 1h, 8h). Facultatif, 1h par défaut.
JWT_EXPIRATION=1h

# --- Compte ADMIN initial (créé au premier démarrage d'auth-service s'il n'existe aucun admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-123
ADMIN_NAME=Administrateur

# --- claim-service : pièces jointes ---
# Dossier de stockage, HORS du dépôt Git (facultatif ; défaut : <dossier utilisateur>/reclamations-data/attachments).
# Utiliser des "/" (ex. C:/data/reclamations/attachments) : le "\" est interprété dans ce fichier.
# CLAIMS_STORAGE_DIR=
